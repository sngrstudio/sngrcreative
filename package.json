{
  "name": "sngrcreative",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "conc bun:check:* && astro build",
    "cf-typegen": "wrangler types",
    "check:astro": "astro check",
    "check:style": "prettier --check .",
    "deploy": "conc bun:build && wrangler pages deploy",
    "dev": "astro dev --host=0.0.0.0",
    "format": "prettier --write .",
    "preview": "conc bun:build && wrangler pages dev --ip=0.0.0.0",
    "start": "conc bun:preview"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "12.6.13",
    "@astrojs/react": "6.0.5",
    "@keystatic/astro": "5.2.0",
    "@keystatic/core": "0.6.9",
    "@tailwindcss/vite": "4.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "astro": "5.7.4",
    "concurrently": "9.2.4",
    "prettier": "3.9.6",
    "prettier-config-standard": "7.0.0",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3",
    "wrangler": "4.129.0"
  }
}
